# Copy to .env — never commit .env.
CLEVER_ENV=dev
LOG_LEVEL=info

# Gateway key for chat / dashboard / Swagger Authorize (not the LLM vendor key)
CLEVER_API_KEY=dev-key-change-me
CLEVER_ADMIN_KEY=dev-admin-change-me

# auto | openai_compat | bedrock | mock
# auto uses Bedrock if complete, else HTTP API if complete, else mock (UI will say MOCK).
LLM_PROVIDER=auto
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=1024
LLM_THINKING=disabled

# HTTP chat-completions API (fill all four or leave all empty)
LLM_API_KEY=
LLM_BASE_URL=
COMPAT_MODEL_CHEAP=
COMPAT_MODEL_STRONG=

# AWS Bedrock (fill all or leave empty — partial config refuses to start)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
BEDROCK_MODEL_CHEAP=
BEDROCK_MODEL_STRONG=

POSTGRES_DSN=postgresql://clever:clever@localhost:5432/clever
REDIS_URL=redis://:clever@localhost:6379/0
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
