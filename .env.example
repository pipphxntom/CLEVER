# Copy to .env and fill in locally. NEVER commit .env.
CLEVER_ENV=dev
LOG_LEVEL=info

# Auth — required on every /v1 call. Change these.
CLEVER_API_KEY=dev-key-change-me
CLEVER_ADMIN_KEY=dev-admin-change-me

# LLM. Default mock is for tests and local runs without a key.
# openai_compat: any OpenAI-compatible HTTP API (set KEY, BASE_URL, MODEL_*).
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
MODEL_CHEAP=
MODEL_STRONG=
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=1024

# Local infra (Rancher Desktop dockerd — Cvent-supported. Not Docker Desktop.)
# powershell -File scripts\start-stack.ps1
POSTGRES_DSN=postgresql://clever:clever@localhost:5432/clever
REDIS_URL=redis://:clever@localhost:6379/0

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
