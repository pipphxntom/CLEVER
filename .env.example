# Copy to .env and fill in locally. NEVER commit .env.
CLEVER_ENV=dev
LOG_LEVEL=info

CLEVER_API_KEY=dev-key-change-me
CLEVER_ADMIN_KEY=dev-admin-change-me

# mock | openai_compat | bedrock | auto
# auto starts every backend that has complete credentials.
LLM_PROVIDER=auto
LLM_TIMEOUT_S=90
LLM_MAX_TOKENS=1024
LLM_THINKING=disabled

# OpenAI-compatible (/v1/chat/completions)
LLM_API_KEY=
LLM_BASE_URL=
COMPAT_MODEL_CHEAP=
COMPAT_MODEL_STRONG=

# AWS Bedrock — static keys preferred (no SSO required on this host)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
BEDROCK_MODEL_CHEAP=
BEDROCK_MODEL_STRONG=

POSTGRES_DSN=postgresql://clever:clever@localhost:5432/clever
REDIS_URL=redis://:clever@localhost:6379/0
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
